exports[`App DOM contract (tripwire) > matches the default-state DOM snapshot 1`] = `"<main class="app-shell"><div class="message-toast-region" role="status" aria-live="polite"></div><header class="topbar"><div class="brand-lockup"><svg class="brand-logo" viewBox="0 0 56 48" aria-hidden="true" focusable="false"><path d="M3 3h50v25H31v17H3z" fill="var(--piece-selected-fill)" stroke="var(--wall-edge)" stroke-linejoin="round" stroke-width="3"></path><rect x="9" y="9" width="11" height="13" rx="1.5" fill="var(--piece-fill)" stroke="var(--primary-background)" stroke-width="2.5"></rect><rect x="26" y="9" width="19" height="11" rx="1.5" fill="var(--piece-fill)" stroke="var(--primary-background)" stroke-width="2.5"></rect><rect x="9" y="28" width="15" height="10" rx="1.5" fill="var(--piece-fill)" stroke="var(--primary-background)" stroke-width="2.5"></rect></svg><div class="brand-copy"><h1>Gallery Designer</h1><p>Plan a continuous wall, place art to scale, and export installation measurements.</p></div></div></header><section class="workspace"><aside class="setup-panel" aria-label="Setup controls"><section class="utility-panel feature-panel collapsible-panel setup-utility-panel wall-sections-panel" aria-label="Wall section settings"><button type="button" class="collapsible-panel-trigger" aria-expanded="true" aria-controls=":r0:"><span class="panel-title"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ruler"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path><path d="m14.5 12.5 2-2"></path><path d="m11.5 9.5 2-2"></path><path d="m8.5 6.5 2-2"></path><path d="m17.5 15.5 2-2"></path></svg><h2>Wall sections</h2><span class="count-badge">1</span></span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="n